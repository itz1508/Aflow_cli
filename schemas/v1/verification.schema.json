{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://theoneshot.dev/schemas/aflow/v1/verification.schema.json",
  "title": "A-Flow executable verification artifact",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "artifact_version", "producer_version"],
  "properties": {
    "schema_version": {"type": "string", "const": "1.0.0"},
    "artifact_version": {"type": "string", "const": "1.0"},
    "producer_version": {"type": "string", "minLength": 1},
    "validation_id": {"type": "string", "minLength": 1},
    "executable": {"type": "string", "minLength": 1},
    "arguments": {"type": "array", "items": {"type": "string"}},
    "working_directory": {"type": "string"},
    "timeout_seconds": {"type": "number", "exclusiveMinimum": 0, "maximum": 3600},
    "environment_allowlist": {"type": "array", "items": {"type": "string"}},
    "stdin_policy": {"enum": ["closed"]},
    "expected_exit_codes": {"type": "array", "items": {"type": "integer"}, "minItems": 1},
    "maximum_stdout_bytes": {"type": "integer", "minimum": 1},
    "maximum_stderr_bytes": {"type": "integer", "minimum": 1},
    "encoding": {"type": "string"},
    "required": {"type": "boolean"}
  }
}
